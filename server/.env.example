NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Paste the Atlas URI for a dedicated database user here. Never use VITE_ for secrets.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/expense_splitter
# Generate a new value with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters-long
# Set to 1 only when deployed behind exactly one trusted reverse proxy.
TRUST_PROXY=0
